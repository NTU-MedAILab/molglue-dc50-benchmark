__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Third-party source exports and every row-level derivative stay local.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data_builder/data/raw/*
!data_builder/data/raw/.gitkeep
data_builder/data/processed/*
!data_builder/data/processed/.gitkeep

# Full refits contain row-level predictions and are never a public payload.
reports/
runtime/
runtime_logs/

